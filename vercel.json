{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "same-origin" }, { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }] }]
}
