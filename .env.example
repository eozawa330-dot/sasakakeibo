# All values are SERVER ONLY. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Use independent, randomly generated values, at least 24 and 32 characters.
APP_ACCESS_CODE=
SESSION_SECRET=
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_REDIRECT_URI=https://your-domain.example/api/freee/callback
# Optional when the freee token exchange returns company_id.
FREEE_COMPANY_ID=
